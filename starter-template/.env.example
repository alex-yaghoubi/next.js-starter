# The generator creates .env.local with a unique NEXTAUTH_SECRET automatically.
# For a manual setup, create .env.local using these names and a strong random secret.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Set this only when connecting the example appointment actions to your own API.
# The starter must never call a production Octavia endpoint by default.
APPOINTMENT_API_BASE_URL=
